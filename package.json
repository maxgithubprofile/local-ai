{
  "name": "local-ai",
  "version": "0.0.0",
  "description": "TS/Capacitor library for an offline LLM + embedding assistant (local model, local SQLite, local vector search, multi-chat conversations). See docs/2026-08-10-local-ai-library-tz.md.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./adapters/capacitor": {
      "types": "./dist/adapters/capacitor/index.d.ts",
      "import": "./dist/adapters/capacitor/index.js",
      "require": "./dist/adapters/capacitor/index.cjs"
    },
    "./adapters/node-testing": {
      "types": "./dist/adapters/node-testing/index.d.ts",
      "import": "./dist/adapters/node-testing/index.js",
      "require": "./dist/adapters/node-testing/index.cjs"
    }
  },
  "main": "./dist/core/index.cjs",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-sqlite vitest run --dir test/unit --passWithNoTests",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-sqlite vitest run --dir test/integration --passWithNoTests",
    "test:contract": "cross-env NODE_OPTIONS=--experimental-sqlite vitest run --dir test/contract --passWithNoTests",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-sqlite vitest",
    "docs": "typedoc"
  },
  "peerDependencies": {
    "@capacitor-community/sqlite": ">=8.0.0",
    "@capacitor/app": ">=8.0.0",
    "@capacitor/core": ">=8.0.0",
    "@capacitor/filesystem": ">=8.0.0",
    "@capgo/capacitor-device-info": ">=8.0.0",
    "@capgo/capacitor-downloader": ">=8.0.0",
    "llama-cpp-capacitor": ">=0.1.5"
  },
  "peerDependenciesMeta": {
    "@capacitor-community/sqlite": {
      "optional": true
    },
    "@capacitor/app": {
      "optional": true
    },
    "@capacitor/core": {
      "optional": true
    },
    "@capacitor/filesystem": {
      "optional": true
    },
    "@capgo/capacitor-device-info": {
      "optional": true
    },
    "@capgo/capacitor-downloader": {
      "optional": true
    },
    "llama-cpp-capacitor": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3",
      "node-llama-cpp"
    ]
  },
  "devDependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capgo/capacitor-device-info": "^8.0.10",
    "@capgo/capacitor-downloader": "^8.1.31",
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.9.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "llama-cpp-capacitor": "^0.1.5",
    "node-llama-cpp": "^3.19.1",
    "sqlite-vec": "^0.1.9",
    "tsup": "^8.2.0",
    "typedoc": "^0.26.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0"
  }
}
